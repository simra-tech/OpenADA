{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simra-tech/OpenADA/main/evaluation/kg/kg-schema-v0.json",
  "title": "OpenADA evaluation analog-design knowledge graph v0",
  "description": "Closed research-spike schema for evidence-bearing analog-design property graphs.",
  "type": "object",
  "required": [
    "schema",
    "graph_id",
    "graph_version",
    "title",
    "description",
    "source_snapshot",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "openada.eval/analog-knowledge-graph/v0"
    },
    "graph_id": {
      "$ref": "#/$defs/id"
    },
    "graph_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "title": {
      "$ref": "#/$defs/nonemptyString"
    },
    "description": {
      "$ref": "#/$defs/boundedString"
    },
    "source_snapshot": {
      "$ref": "#/$defs/sourceSnapshot"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,159}$",
      "maxLength": 160
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "boundedString": {
      "type": "string",
      "maxLength": 4000
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSnapshot": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "policy"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nonemptyString"
        },
        "revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "policy": {
          "const": "tracked-public-files-only"
        }
      },
      "additionalProperties": false
    },
    "scalarValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      ]
    },
    "namedValue": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "additionalProperties": false
    },
    "continuousDomain": {
      "type": "object",
      "required": [
        "minimum",
        "maximum",
        "quantum"
      ],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "quantum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "additionalProperties": false
    },
    "integerDomain": {
      "type": "object",
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "limit": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "corner": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "corner": {
              "$ref": "#/$defs/id"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "taskAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "task_version",
        "schema_version",
        "harness",
        "pdk",
        "simulator",
        "status",
        "image_digest"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "task_version": {
          "type": "integer",
          "minimum": 0
        },
        "schema_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "harness": {
          "$ref": "#/$defs/nonemptyString"
        },
        "pdk": {
          "$ref": "#/$defs/nonemptyString"
        },
        "simulator": {
          "$ref": "#/$defs/nonemptyString"
        },
        "status": {
          "enum": [
            "active",
            "draft"
          ]
        },
        "image_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "deviceAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "device_class",
        "instances"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "device_class": {
          "enum": [
            "matched_group",
            "transistor",
            "passive",
            "model_element"
          ]
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "model_name": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "additionalProperties": false
    },
    "blockAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "role"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "additionalProperties": false
    },
    "topologyAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "topology_id",
        "fixed"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "topology_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "fixed": {
          "type": "boolean"
        },
        "template_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "parameterAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "semantic_name",
        "value_type",
        "targets",
        "domain"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "semantic_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "value_type": {
          "enum": [
            "continuous",
            "integer"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "domain": {
          "oneOf": [
            {
              "$ref": "#/$defs/continuousDomain"
            },
            {
              "$ref": "#/$defs/integerDomain"
            }
          ]
        },
        "reference": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "measurementAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "semantic_name",
        "unit"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "semantic_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "method_summary": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "additionalProperties": false
    },
    "specRowAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "semantic_name",
        "measurement",
        "condition",
        "operator",
        "unit",
        "report_only",
        "limits",
        "qualifiers"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "semantic_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "measurement": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "$ref": "#/$defs/id"
        },
        "operator": {
          "enum": [
            "<=",
            ">=",
            "between",
            "report_only"
          ]
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "report_only": {
          "type": "boolean"
        },
        "limits": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/limit"
          }
        },
        "qualifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/namedValue"
          }
        }
      },
      "additionalProperties": false
    },
    "cornerAttributes": {
      "type": "object",
      "required": [
        "corner_id",
        "process",
        "temperature_c",
        "supply_v",
        "model_bundle_hash",
        "status",
        "task_ids"
      ],
      "properties": {
        "corner_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "process": {
          "$ref": "#/$defs/nonemptyString"
        },
        "temperature_c": {
          "type": "number"
        },
        "supply_v": {
          "type": "number"
        },
        "model_bundle_hash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "active",
            "historical"
          ]
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "conditionAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "condition_id",
        "role",
        "values"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "condition_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "enum": [
            "condition_set",
            "operating_point",
            "validity_predicate"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/namedValue"
          }
        }
      },
      "additionalProperties": false
    },
    "mechanismAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "category",
        "summary"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "category": {
          "enum": [
            "physical",
            "model",
            "measurement",
            "structural"
          ]
        },
        "summary": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "additionalProperties": false
    },
    "tradeoffAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "summary",
        "observed"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "summary": {
          "$ref": "#/$defs/boundedString"
        },
        "observed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "recipeStageAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "stage_id",
        "order",
        "analysis",
        "deck",
        "outputs"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "stage_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "analysis": {
          "enum": [
            "dc",
            "tran",
            "ac",
            "derived",
            "gate"
          ]
        },
        "deck": {
          "$ref": "#/$defs/nonemptyString"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "validityGateAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "gate_id",
        "predicate",
        "failure_state",
        "thresholds"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "gate_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "predicate": {
          "$ref": "#/$defs/boundedString"
        },
        "failure_state": {
          "enum": [
            "unknown",
            "invalid",
            "fail"
          ]
        },
        "thresholds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/namedValue"
          }
        }
      },
      "additionalProperties": false
    },
    "trapAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "claim",
        "correction"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "claim": {
          "$ref": "#/$defs/boundedString"
        },
        "correction": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "additionalProperties": false
    },
    "modelArtifactAttributes": {
      "type": "object",
      "required": [
        "task_id",
        "artifact_name",
        "state",
        "version"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "artifact_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "state": {
          "enum": [
            "unpatched",
            "patched",
            "base",
            "unresolved"
          ]
        },
        "version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "attributes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "Task",
            "Device",
            "Block",
            "Topology",
            "Parameter",
            "Measurement",
            "SpecRow",
            "Corner",
            "Condition",
            "Mechanism",
            "Tradeoff",
            "RecipeStage",
            "ValidityGate",
            "Trap",
            "ModelArtifact"
          ]
        },
        "name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "description": {
          "$ref": "#/$defs/boundedString"
        },
        "attributes": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Task"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/taskAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Device"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/deviceAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Block"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/blockAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Topology"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/topologyAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Parameter"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/parameterAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Measurement"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/measurementAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SpecRow"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/specRowAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Corner"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/cornerAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Condition"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/conditionAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Mechanism"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/mechanismAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Tradeoff"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/tradeoffAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RecipeStage"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/recipeStageAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ValidityGate"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/validityGateAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Trap"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/trapAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ModelArtifact"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/modelArtifactAttributes"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencePointer": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "path",
        "section"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nonemptyString"
        },
        "revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^/]"
        },
        "section": {
          "$ref": "#/$defs/nonemptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "grade",
        "basis",
        "pointers"
      ],
      "properties": {
        "grade": {
          "enum": [
            "measured",
            "derived",
            "textbook"
          ]
        },
        "basis": {
          "enum": [
            "simulation_sweep",
            "task_contract",
            "recipe_contract",
            "calculation",
            "causal_interpretation",
            "textbook_prior",
            "model_debug"
          ]
        },
        "pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencePointer"
          }
        },
        "summary": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "quantity",
        "intervention",
        "unit"
      ],
      "properties": {
        "quantity": {
          "$ref": "#/$defs/nonemptyString"
        },
        "intervention": {
          "$ref": "#/$defs/nonemptyString"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "baseline": {
          "type": "number"
        },
        "observed": {
          "type": "number"
        },
        "delta": {
          "type": "number"
        },
        "ratio": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "note": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "anyOf": [
        {
          "required": [
            "baseline"
          ]
        },
        {
          "required": [
            "observed"
          ]
        },
        {
